    };

    document.getElementById('omniBuildBtn').onclick = buildOmniCopy;
    document.getElementById('omniPresetSel').onchange = buildOmniCopy;
    studio.querySelectorAll('button[data-copy]').forEach(btn => {
      btn.onclick = () => {
        const el = document.getElementById(btn.dataset.copy);
        if (!el) return;
        navigator.clipboard?.writeText(el.value);
        const orig = btn.textContent;
        btn.textContent = 'Copied ✓';
       setTimeout(() => { btn.textContent = orig; }, 1400);
      };
    });
    buildOmniCopy();
  }
})();
