    bgAudio.currentTime = 0;
    isSpeaking = false;
  };

  function renderLoop() {
    ctx.fillStyle = '#071329';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = '#0b1c3d';
    ctx.fillRect(0, 0, canvas.width, 84);
    ctx.fillStyle = '#f5b82e';
    ctx.font = '800 28px system-ui, Arial, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('SAAHIRIDES • SAFERIDE @ SAAHIPRICE', canvas.width / 2, 52);

    const energy = getVoiceEnergy();
    const activeVoice = energy > 0.04;

    const boxX = 36, boxY = 100, boxW = canvas.width - 72, boxH = 1010;
    ctx.save();
    ctx.strokeStyle = activeVoice ? '#38bdf8' : '#f5b82e';
    ctx.lineWidth = activeVoice ? (4 + energy * 6) : 3;
    ctx.strokeRect(boxX, boxY, boxW, boxH);
    
     if (posterImg && posterImg.complete && posterImg.naturalWidth > 0) {
      const scale = Math.min(boxW / posterImg.naturalWidth, boxH / posterImg.naturalHeight);
      const dw = posterImg.naturalWidth * scale;
      const dh = posterImg.naturalHeight * scale;
      ctx.drawImage(posterImg, boxX + (boxW - dw) / 2, boxY + (boxH - dh) / 2, dw, dh);
    }

    const rawOverlay = scriptInput.value.trim();
    if (rawOverlay) {
      ctx.fillStyle = 'rgba(6, 18, 46, 0.80)';
      ctx.fillRect(boxX + 24, boxY + 340, boxW - 48, 330);
      ctx.strokeStyle = activeVoice ? '#00f0ff' : 'rgba(245,184,46,0.75)';
      ctx.lineWidth = 2.5;
      ctx.strokeRect(boxX + 24, boxY + 340, boxW - 48, 330);

      ctx.fillStyle = '#ffffff';
      ctx.font = '700 30px system-ui, Arial, sans-serif';
      ctx.textAlign = 'center';
      const words = rawOverlay.split(/\s+/);
      let line = '', lineY = boxY + 392;
      for (let i = 0; i < words.length; i++) {
        const test = line + words[i] + ' ';
        if (ctx.measureText(test).width > boxW - 96 && i > 0) {
          ctx.fillText(line.trim(), canvas.width / 2, lineY);
          line = words[i] + ' ';
          lineY += 40;
          if (lineY > boxY + 635) break;
        } else { line = test; }
      }
      if (lineY <= boxY + 635) ctx.fillText(line.trim(), canvas.width / 2, lineY);
    }
    ctx.restore();

    ctx.fillStyle = '#030817';
    ctx.fillRect(0, 1135, canvas.width, 145);
    ctx.fillStyle = '#ffe27a';
    ctx.font = '800 34px system-ui, Arial, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText(marqueeText, marqueeX, 1218);

    if (isScrolling) {
      marqueeX -= parseFloat(speedSelect.value || '3.8');
      const totalW = ctx.measureText(marqueeText).width;
      if (marqueeX < -totalW) marqueeX = canvas.width;
    }
    requestAnimationFrame(renderLoop);
  }
  requestAnimationFrame(renderLoop);

