  document.getElementById('tbToggleScrollBtn').onclick = () => { isScrolling = !isScrolling; };

  function playNarration(onDone) {
    const raw = scriptInput.value.trim();
    if (bgAudio.src) {
      ensureAudioAnalyzer();
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
      if (window.speechSynthesis) window.speechSynthesis.cancel();
      bgAudio.currentTime = 0;
      isSpeaking = true;
      bgAudio.onended = () => { isSpeaking = false; if (onDone) onDone(); };
      bgAudio.play();
      return;
    }
    if (!raw || !('speechSynthesis' in window)) { if (onDone) onDone(); return; }
    window.speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(raw);
    const voices = window.speechSynthesis.getVoices();
    const hindiVoice = voices.find(v => v.lang.toLowerCase().includes('hi-in')) || voices.find(v => v.lang.toLowerCase().includes('en-in'));
    if (hindiVoice) utter.voice = hindiVoice;
    utter.lang = 'hi-IN';
    utter.rate = 0.96;
    utter.onstart = () => { isSpeaking = true; };
    utter.onend = () => { isSpeaking = false; if (onDone) onDone(); };
    utter.onerror = () => { isSpeaking = false; if (onDone) onDone(); };
    window.speechSynthesis.speak(utter);
  }

  document.getElementById('tbSpeakPosterBtn').onclick = () => playNarration();
